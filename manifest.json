{
  "schemaVersion": 1,
  "id": "neuromante.omarchy-edge-packages",
  "name": "Omarchy Edge Packages",
  "version": "1.3.0",
  "author": "neuromante",
  "description": "RSS feed of new and updated packages in Omarchy edge repositories",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Edge Packages",
    "description": "New and updated packages from the core, extra, multilib, and omarchy edge repositories",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "itemLimit": "50",
      "refreshIntervalMinutes": 15,
      "feedUrl": "https://neuromante.github.io/omarchy-edge-packages/feed.xml"
    },
    "schema": [
      {
        "key": "itemLimit",
        "type": "enum",
        "label": "Packages to show",
        "description": "Maximum number of recent feed entries shown in the panel.",
        "options": ["10", "50", "100"],
        "defaultValue": "50"
      },
      {
        "key": "refreshIntervalMinutes",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "description": "How often to fetch the RSS feed.",
        "min": 15,
        "max": 360,
        "step": 15,
        "defaultValue": 15
      },
      {
        "key": "feedUrl",
        "type": "string",
        "label": "RSS feed URL",
        "defaultValue": "https://neuromante.github.io/omarchy-edge-packages/feed.xml"
      }
    ]
  }
}
